# Copy this file to a new file named .env (same folder) and fill in the two values
# from your Supabase project: Settings > API Keys (or the "Connect" button).
#
# VITE_SUPABASE_URL:             looks like https://abcdxyz.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: starts with sb_publishable_ (older projects: the long "anon" key)
#
# NEVER put the "secret" key (sb_secret_...) or the legacy "service_role" key here,
# and never share your database password. Those can bypass all security rules.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional now, set when the site goes live: the public address, with no slash at the end,
# for example https://www.auxesisproduce.co.ke. It is used for sharing previews and the sitemap.
VITE_SITE_URL=
